{
    "name": "factorio-blueprint-editor",
    "private": true,
    "workspaces": [
        "packages/editor",
        "packages/website",
        "packages/worker"
    ],
    "scripts": {
        "localpreview": "node scripts/localpreview.mjs",
        "start:website": "npm --workspace=@fbe/website run start",
        "preview:website": "npm --workspace=@fbe/website run preview",
        "start:exporter": "cd ./packages/exporter && cargo run --release",
        "build:website": "npm --workspace=@fbe/website run build",
        "test:unit": "npm --workspace=@fbe/editor run test:unit",
        "lint": "vp lint .",
        "lint:fix": "vp lint . --fix",
        "format": "vp fmt . --check",
        "format:fix": "vp fmt .",
        "test:e2e": "npx playwright test",
        "test:e2e:report": "npx playwright test --reporter=list"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.0",
        "@types/node": "^26.1.2",
        "serve": "^14.2.6",
        "typed-factorio": "^3.36.0",
        "typescript": "^7.0.2",
        "vite-plus": "0.2.9"
    },
    "devEngines": {
        "packageManager": {
            "name": "npm",
            "version": "^12",
            "onFail": "download"
        }
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9"
    }
}
