{
    "private": true,
    "workspaces": [
        "packages/editor",
        "packages/website"
    ],
    "scripts": {
        "start:website": "npm --workspace=@fbe/website run start",
        "preview:website": "npm --workspace=@fbe/website run preview",
        "start:exporter": "cd ./packages/exporter && cargo run --release",
        "build:website": "npm --workspace=@fbe/website run build",
        "type-check": "tsc",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --check",
        "format:fix": "prettier . --write",
        "test": "npx playwright test",
        "test:report": "npx playwright test --reporter=list"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.58.2",
        "eslint": "^10.0.3",
        "prettier": "^3.8.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.57.1"
    }
}
