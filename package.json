{
    "private": true,
    "workspaces": [
        "packages/editor",
        "packages/website"
    ],
    "scripts": {
        "start:website": "npm --workspace=@fbe/website run start",
        "preview:website": "npm --workspace=@fbe/website run preview",
        "start:exporter": "cd ./packages/exporter && cargo run --release",
        "build:website": "npm --workspace=@fbe/website run build",
        "type-check": "tsc",
        "type-check:gate": "node scripts/type-check-gate.mjs",
        "test:unit": "npm --workspace=@fbe/editor run test:unit",
        "lint": "vp lint .",
        "lint:fix": "vp lint . --fix",
        "format": "vp fmt . --check",
        "format:fix": "vp fmt .",
        "test:e2e": "npx playwright test",
        "test:e2e:report": "npx playwright test --reporter=list"
    },
    "devDependencies": {
        "@playwright/test": "^1.58.2",
        "typed-factorio": "^3.35.0",
        "typescript": "^5.9.3",
        "vite-plus": "0.2.1"
    },
    "devEngines": {
        "packageManager": {
            "name": "npm",
            "version": "11.18.0",
            "onFail": "download"
        }
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@0.2.1",
        "vitest": "4.1.9"
    }
}
