{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ES6",
        "skipLibCheck": true,

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "noEmit": true,

        // TS7 defaults `strict` to true; pin false to preserve the pre-TS7
        // behavior (the codebase's ~850 strict-mode errors are a separate
        // cleanup - see type-check-baseline.json). TODO: enable strict.
        "strict": false,

        "paths": {
            "@fbe/*": ["./packages/*/src/index.ts"]
        },

        "types": ["vite-plus/client", "typed-factorio/prototype"]
    }
}
